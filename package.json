{
  "name": "purrfect",
  "version": "0.0.11",
  "description": "Collection of composable tools and abstractions for building metadata extraction pipelines, aggregations, indexes, visualizations, and metadata endpoints.",
  "author": "Noodlestan Collective",
  "license": "MIT",
  "private": true,
  "packageManager": "npm@10.2.3",
  "workspaces": [
    "libs/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "turbo": "turbo",
    "dev": "turbo run dev --ui tui",
    "clean": "turbo run build:clean",
    "lint": "prettier . -c",
    "lint:fix": "prettier . -c --write",
    "extract": "turbo run extract",
    "ci:root": "npm run lint",
    "ci": "npm run ci:root && turbo run ci"
  },
  "devDependencies": {
    "@noodlestan/conventions-typescript": "0.1.0",
    "@noodlestan/conventions-unit-tests": "0.1.0",
    "@noodlestan/eslint-config": "0.0.8",
    "@noodlestan/tsconfig": "^0.2.0",
    "lefthook": "2.1.9",
    "prettier": "3.8.4",
    "turbo": "2.9.18"
  }
}
